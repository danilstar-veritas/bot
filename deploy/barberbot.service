# Автозапуск бота на Linux-сервері (systemd).
# Встановлення: див. README.md, розділ «Запуск 24/7 на сервері».

[Unit]
Description=Barber Bot (Telegram + AI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barberbot
WorkingDirectory=/opt/barber-bot
ExecStart=/usr/bin/python3 /opt/barber-bot/run.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Час у журналі — київський (на час записів не впливає: його бот рахує за часовим поясом закладу).
Environment=TZ=Europe/Kyiv

[Install]
WantedBy=multi-user.target
